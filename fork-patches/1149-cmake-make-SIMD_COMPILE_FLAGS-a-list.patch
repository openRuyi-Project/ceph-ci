From 30e4542b2d62dda456b9ed23d78106bccde1a436 Mon Sep 17 00:00:00 2001
From: Sun Yuechi <sunyuechi@iscas.ac.cn>
Date: Tue, 13 Oct 2026 11:28:08 -0700
Subject: [PATCH] cmake: make SIMD_COMPILE_FLAGS a list

SIMD_COMPILE_FLAGS was built as a space-separated string with a leading
space. Since d6728294f26 it is passed to target_compile_options(), which
quotes it as a single argument, so on riscv64 gcc sees
" -march=rv64gcv_zbc_zvbc" as an input file and building crc32c.cc fails.

Build it with list(APPEND) instead, and pass it to gf-complete_objs via
target_compile_options() rather than the COMPILE_FLAGS string property.

Signed-off-by: Sun Yuechi <sunyuechi@iscas.ac.cn>
---
 cmake/modules/SIMDExt.cmake              | 24 ++++++++++++------------
 src/erasure-code/jerasure/CMakeLists.txt |  3 +--
 2 files changed, 13 insertions(+), 14 deletions(-)

diff --git a/cmake/modules/SIMDExt.cmake b/cmake/modules/SIMDExt.cmake
index dfa7ffb7f0c..441bcab00d7 100644
--- a/cmake/modules/SIMDExt.cmake
+++ b/cmake/modules/SIMDExt.cmake
@@ -46,14 +46,14 @@ if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|AARCH64")
 
   CHECK_C_COMPILER_FLAG(-march=armv8-a+simd HAVE_ARMV8_SIMD)
   if(HAVE_ARMV8_SIMD)
-    set(SIMD_COMPILE_FLAGS "${SIMD_COMPILE_FLAGS} -march=armv8-a+simd")
+    list(APPEND SIMD_COMPILE_FLAGS -march=armv8-a+simd)
   endif()
 
 elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "arm|ARM")
   set(HAVE_ARM 1)
   CHECK_C_COMPILER_FLAG(-mfpu=neon HAVE_ARM_NEON)
   if(HAVE_ARM_NEON)
-    set(SIMD_COMPILE_FLAGS "${SIMD_COMPILE_FLAGS} -mfpu=neon")
+    list(APPEND SIMD_COMPILE_FLAGS -mfpu=neon)
   endif()
 
 elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "i386|i686|amd64|x86_64|AMD64")
@@ -61,32 +61,32 @@ elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "i386|i686|amd64|x86_64|AMD64")
   if(CMAKE_SYSTEM_PROCESSOR MATCHES "i686|amd64|x86_64|AMD64")
     CHECK_C_COMPILER_FLAG(-msse HAVE_INTEL_SSE)
     if(HAVE_INTEL_SSE)
-      set(SIMD_COMPILE_FLAGS "${SIMD_COMPILE_FLAGS} -msse")
+      list(APPEND SIMD_COMPILE_FLAGS -msse)
     endif()
     if(CMAKE_SYSTEM_PROCESSOR MATCHES "amd64|x86_64|AMD64")
       CHECK_C_COMPILER_FLAG(-msse2 HAVE_INTEL_SSE2)
       if(HAVE_INTEL_SSE2)
-        set(SIMD_COMPILE_FLAGS "${SIMD_COMPILE_FLAGS} -msse2")
+        list(APPEND SIMD_COMPILE_FLAGS -msse2)
       endif()
       CHECK_C_COMPILER_FLAG(-msse3 HAVE_INTEL_SSE3)
       if(HAVE_INTEL_SSE3)
-        set(SIMD_COMPILE_FLAGS "${SIMD_COMPILE_FLAGS} -msse3")
+        list(APPEND SIMD_COMPILE_FLAGS -msse3)
       endif()
       CHECK_C_COMPILER_FLAG(-mssse3 HAVE_INTEL_SSSE3)
       if(HAVE_INTEL_SSSE3)
-        set(SIMD_COMPILE_FLAGS "${SIMD_COMPILE_FLAGS} -mssse3")
+        list(APPEND SIMD_COMPILE_FLAGS -mssse3)
       endif()
       CHECK_C_COMPILER_FLAG(-mpclmul HAVE_INTEL_PCLMUL)
       if(HAVE_INTEL_PCLMUL)
-        set(SIMD_COMPILE_FLAGS "${SIMD_COMPILE_FLAGS} -mpclmul")
+        list(APPEND SIMD_COMPILE_FLAGS -mpclmul)
       endif()
       CHECK_C_COMPILER_FLAG(-msse4.1 HAVE_INTEL_SSE4_1)
       if(HAVE_INTEL_SSE4_1)
-        set(SIMD_COMPILE_FLAGS "${SIMD_COMPILE_FLAGS} -msse4.1")
+        list(APPEND SIMD_COMPILE_FLAGS -msse4.1)
       endif()
       CHECK_C_COMPILER_FLAG(-msse4.2 HAVE_INTEL_SSE4_2)
       if(HAVE_INTEL_SSE4_2)
-        set(SIMD_COMPILE_FLAGS "${SIMD_COMPILE_FLAGS} -msse4.2")
+        list(APPEND SIMD_COMPILE_FLAGS -msse4.2)
       endif()
     endif(CMAKE_SYSTEM_PROCESSOR MATCHES "amd64|x86_64|AMD64")
   endif(CMAKE_SYSTEM_PROCESSOR MATCHES "i686|amd64|x86_64|AMD64")
@@ -133,11 +133,11 @@ elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "riscv64|RISCV64")
   endif()
 
   if(HAVE_RISCV_ZVBC)
-    set(SIMD_COMPILE_FLAGS "${SIMD_COMPILE_FLAGS} -march=rv64gcv_zbc_zvbc")
+    list(APPEND SIMD_COMPILE_FLAGS -march=rv64gcv_zbc_zvbc)
   elseif(HAVE_RISCV_ZBC)
-    set(SIMD_COMPILE_FLAGS "${SIMD_COMPILE_FLAGS} -march=rv64gc_zbc")
+    list(APPEND SIMD_COMPILE_FLAGS -march=rv64gc_zbc)
   elseif(HAVE_RISCV_RVV)
-    set(SIMD_COMPILE_FLAGS "${SIMD_COMPILE_FLAGS} -march=rv64gcv")
+    list(APPEND SIMD_COMPILE_FLAGS -march=rv64gcv)
   else()
     message(WARNING " RISC-V crypto/vector extensions NOT detected by compiler.")
   endif()
diff --git a/src/erasure-code/jerasure/CMakeLists.txt b/src/erasure-code/jerasure/CMakeLists.txt
index c97888fd989..ed14b56d2ca 100644
--- a/src/erasure-code/jerasure/CMakeLists.txt
+++ b/src/erasure-code/jerasure/CMakeLists.txt
@@ -72,8 +72,7 @@ if(HAVE_ARM_NEON OR HAVE_ARMV8_SIMD)
 endif()
 
 add_library(gf-complete_objs OBJECT ${gf-complete_srcs})
-set_target_properties(gf-complete_objs PROPERTIES
-  COMPILE_FLAGS "${SIMD_COMPILE_FLAGS}")
+target_compile_options(gf-complete_objs PRIVATE ${SIMD_COMPILE_FLAGS})
 set_target_properties(gf-complete_objs PROPERTIES
   COMPILE_DEFINITIONS "${GF_COMPILE_FLAGS}")
 
-- 
2.56.0

