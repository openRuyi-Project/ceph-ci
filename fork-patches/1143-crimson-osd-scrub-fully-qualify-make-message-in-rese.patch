From 533decd618d9f1a5163b140a84285b046ca607a1 Mon Sep 17 00:00:00 2001
From: Sun Yuechi <sunyuechi@iscas.ac.cn>
Date: Sat, 21 Nov 2026 02:27:20 -0800
Subject: [PATCH] crimson/osd/scrub: Fully qualify make_message in reservation
 code

4b09a55db2e added unqualified calls to make_message<MOSDScrubReserve>()
in namespace crimson. MOSDScrubReserve friends ceph::make_message, so ADL
finds it alongside crimson::make_message, making the call ambiguous.

Qualify with crimson::, whose MURef result is what MessageURef and
send_to_osd() expect.

Signed-off-by: Sun Yuechi <sunyuechi@iscas.ac.cn>
---
 src/crimson/osd/scrub/scrub_machine.cc      | 6 +++---
 src/crimson/osd/scrub/scrub_reservations.cc | 4 ++--
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/crimson/osd/scrub/scrub_machine.cc b/src/crimson/osd/scrub/scrub_machine.cc
index 577ead8e8c6..989fda41b2c 100644
--- a/src/crimson/osd/scrub/scrub_machine.cc
+++ b/src/crimson/osd/scrub/scrub_machine.cc
@@ -452,7 +452,7 @@ void ReplicaActive::handle_reservation_request(
         "immediately granting reservation request from {}",
         dpp,
         from);
-      reply = make_message<MOSDScrubReserve>(
+      reply = crimson::make_message<MOSDScrubReserve>(
         spg_t(pg_id.pgid, primary_shard),
         map_epoch,
         MOSDScrubReserve::GRANT,
@@ -465,7 +465,7 @@ void ReplicaActive::handle_reservation_request(
         dpp,
         from);
       m_reservation_status = reservation_status_t::unreserved;
-      reply = make_message<MOSDScrubReserve>(
+      reply = crimson::make_message<MOSDScrubReserve>(
         spg_t(pg_id.pgid, primary_shard),
         map_epoch,
         MOSDScrubReserve::REJECT,
@@ -500,7 +500,7 @@ sc::result ReplicaActive::react(const events::reserver_granted_t &event)
   pending_reservation_nonce = 0;
 
   // notify the primary
-  auto grant_msg = make_message<MOSDScrubReserve>(
+  auto grant_msg = crimson::make_message<MOSDScrubReserve>(
       spg_t(pg_id.pgid, pg.get_primary().shard), reservation.request_epoch,
             MOSDScrubReserve::GRANT, pg.get_pg_whoami(), reservation.nonce);
   std::ignore = pg.get_shard_services().send_to_osd(reservation.from.osd, std::move(grant_msg), reservation.request_epoch);
diff --git a/src/crimson/osd/scrub/scrub_reservations.cc b/src/crimson/osd/scrub/scrub_reservations.cc
index 960894c96db..493f03450b1 100644
--- a/src/crimson/osd/scrub/scrub_reservations.cc
+++ b/src/crimson/osd/scrub/scrub_reservations.cc
@@ -65,7 +65,7 @@ void ReplicaReservations::release_all()
 
   // send 'release' messages to all replicas we have managed to reserve
   for (const auto& peer : replicas) {
-    auto m = make_message<MOSDScrubReserve>(
+    auto m = crimson::make_message<MOSDScrubReserve>(
       spg_t{m_pgid, peer.shard}, epoch, MOSDScrubReserve::RELEASE,
       m_pg->get_pg_whoami(), 0);
     std::ignore = m_pg->get_shard_services().send_to_osd(peer.osd, std::move(m), epoch);
@@ -190,7 +190,7 @@ bool ReplicaReservations::send_next_reservation_or_complete()
   const auto peer = *m_next_to_request;
   const auto epoch = m_pg->get_osdmap_epoch();
   m_last_request_sent_nonce++;
-  auto m = make_message<MOSDScrubReserve>(
+  auto m = crimson::make_message<MOSDScrubReserve>(
       spg_t{m_pgid, peer.shard}, epoch, MOSDScrubReserve::REQUEST, m_pg->get_pg_whoami(),
       m_last_request_sent_nonce);
   std::ignore = m_pg->get_shard_services().send_to_osd(peer.osd, std::move(m), epoch);
-- 
