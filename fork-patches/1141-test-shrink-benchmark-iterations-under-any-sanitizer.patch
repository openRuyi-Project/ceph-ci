 src/test/common/test_memory.cc               |  3 +-
 src/test/objectstore/test_bluestore_types.cc |  3 +-
 src/test/objectstore/test_transaction.cc     |  3 +-
 src/test/sanitized_bench.h                   | 18 +++++++
