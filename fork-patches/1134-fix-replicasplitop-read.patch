     return;
   }
-  
-  // Pick a random valid acting index
-  reference_sub_read = rand() % valid_osd_count;
+
+  reference_valid_index = rand() % valid_indices.size();
+  reference_sub_read = valid_indices[reference_valid_index];
 }
 
